# Copy to .env.local. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/slacklans?sslmode=require
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# MapTiler Cloud Free raster tiles (streets-v4). Create a *protected* key
# (not MapTiler’s default) and restrict HTTP origins: localhost,
# slacklans.vercel.app, and preview hosts.
# https://docs.maptiler.com/guides/maps-apis/maps-platform/how-to-protect-your-map-key/
NEXT_PUBLIC_MAPTILER_KEY=
